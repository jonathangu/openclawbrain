{
  "name": "@openclawbrain/openclaw",
  "version": "0.4.33",
  "description": "OpenClawBrain plugin/runtime payload for OpenClaw. Operator CLI and install helpers move to @openclawbrain/cli.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "Jonathan Gu <jonathangu@gmail.com>",
  "keywords": [
    "openclawbrain",
    "openclaw",
    "plugin",
    "runtime",
    "route-fn",
    "integration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathangu/openclawbrain.git",
    "directory": "packages/openclaw"
  },
  "homepage": "https://github.com/jonathangu/openclawbrain/tree/main/packages/openclaw#readme",
  "bugs": {
    "url": "https://github.com/jonathangu/openclawbrain/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src/index.js",
    "dist/src/index.d.ts",
    "dist/src/runtime-core.js",
    "dist/src/attachment-truth.js",
    "dist/src/attachment-truth.d.ts",
    "dist/src/learning-spine.js",
    "dist/extension",
    "extension",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@openclawbrain/compiler": "0.3.5",
    "@openclawbrain/contracts": "^0.3.5",
    "@openclawbrain/learner": "^0.3.4",
    "@openclawbrain/pack-format": "^0.3.4"
  },
  "openclaw": {
    "extensions": [
      "./dist/extension/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.extension.json",
    "clean": "rm -rf dist/extension",
    "prepublishOnly": "npm run release:verify",
    "release:verify": "npm test && node ../../scripts/verify-openclaw-package-tarball.mjs",
    "test": "node --test dist/test/*.test.js"
  }
}
