{
  "name": "@openclawbrain/openclaw",
  "version": "0.3.5",
  "description": "Primary OpenClawBrain front door for OpenClaw attach, compile, event export, status, and rollback.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "Jonathan Gu <jonathangu@gmail.com>",
  "keywords": [
    "openclawbrain",
    "openclaw",
    "front-door",
    "route-fn",
    "integration",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathangu/openclawbrain.git",
    "directory": "packages/openclaw"
  },
  "homepage": "https://github.com/jonathangu/openclawbrain/tree/main/packages/openclaw#readme",
  "bugs": {
    "url": "https://github.com/jonathangu/openclawbrain/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "dist/extension",
    "extension"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@openclawbrain/compiler": "^0.3.4",
    "@openclawbrain/contracts": "^0.3.4",
    "@openclawbrain/events": "^0.3.4",
    "@openclawbrain/learner": "^0.3.4",
    "@openclawbrain/pack-format": "^0.3.4",
    "@openclawbrain/event-export": "^0.3.4"
  },
  "bin": {
    "openclawbrain": "./dist/src/cli.js",
    "openclawbrain-ops": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b",
    "clean": "rm -rf dist && tsc -b --clean",
    "test": "node --test dist/test/*.test.js"
  }
}
