{
  "name": "openclawbrain",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Local, agent-scoped selective intervention plugin for OpenClaw.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2",
      "pluginSdkVersion": "2026.3.24-beta.2"
    }
  },
  "scripts": {
    "check": "node scripts/build.mjs --check",
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathangu/openclawbrain.git",
    "directory": "packages/openclaw-plugin"
  },
  "homepage": "https://github.com/jonathangu/openclawbrain#readme",
  "bugs": {
    "url": "https://github.com/jonathangu/openclawbrain/issues"
  }
}
