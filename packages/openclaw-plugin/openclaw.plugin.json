          "scope": {
            "preferNarrowestScope": true,
            "allowCurrentRepoInference": true,
            "allowGlobalPreferenceInference": false
          },
          "audit": {
            "recordSkippedCapture": true,
            "recordRejectedCandidates": true,
            "safePreviewOnly": true,
            "enableMemoryPostmortem": true
          }
