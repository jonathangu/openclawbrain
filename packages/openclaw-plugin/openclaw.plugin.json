          "redactBeforeLlm": {
            "type": "boolean",
            "default": true
          },
          "storeDistillationInputs": {
            "type": "boolean",
            "default": false
          },
          "storeDistillationOutputs": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "memory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "captureMode": {
            "type": "string",
