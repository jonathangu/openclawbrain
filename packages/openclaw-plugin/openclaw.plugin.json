              "neverStoreCredentialPlaintext": {
                "type": "boolean",
                "default": true
              },
              "requireNarrowScope": {
                "type": "boolean",
                "default": true
              },
              "preventProactiveDisclosure": {
                "type": "boolean",
                "default": true
              },
              "preferSecureStoreForSensitiveValues": {
                "type": "boolean",
                "default": true
              }
            },
            "default": {
              "allowUserAuthorizedRecallRules": true,
              "neverStoreCredentialPlaintext": true,
              "requireNarrowScope": true,
              "preventProactiveDisclosure": true,
              "preferSecureStoreForSensitiveValues": true
            }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "preferNarrowestScope": {
                "type": "boolean",
                "default": true
              },
              "allowCurrentRepoInference": {
                "type": "boolean",
                "default": true
