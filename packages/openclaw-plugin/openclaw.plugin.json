  "configUiHints": {
    "enabled": {
      "label": "Enabled",
      "help": "Defaults on for the standard local OpenClawBrain path."
    },
    "mode": {
      "label": "Runtime Mode",
      "help": "balanced enables the v0.2 latency-safe memory graph path; conservative/active retain legacy file-backed compatibility modes."
    },
    "activationRoot": {
      "label": "Activation Root",
      "help": "Local agent-scoped root for SQLite state, proof mirrors, and optional compatibility files."
    },
    "llm": {
      "label": "Local LLM Distillation",
      "help": "Defaults to a local Ollama-style OpenAI-compatible JSON endpoint on loopback so the full local brain works out of the box when Ollama is available. Queued packets and planner inputs use redacted user-message summaries only."
    },
    "llm.baseUrl": {
      "label": "Local LLM Base URL",
      "help": "Default loopback OpenAI-compatible endpoint for local semantic distillation. Set a different local endpoint only if you want to override Ollama."
    },
    "privacy": {
      "label": "Privacy Defaults",
      "help": "Raw transcript storage stays hard-disabled. Background packets store redacted summaries and hashes, not raw user-message text."
    },
    "rawTranscriptUpload": {
      "label": "Raw Transcript Upload",
      "help": "Must remain false; true fails closed."
    },
    "capture.mode": {
      "label": "Capture Mode",
      "help": "v0.2.31 defaults to aggressive capture consideration, Memory Authority resolution, conservative Memory Graph Maintenance, and the full Codex Telegram thread bridge. Strict validators decide what can be stored, whether retrieved memories can influence a turn, which graph changes require review, and which Codex thread writes/steers are allowed."
    },
    "routing.maxInjectedMemories": {
      "label": "Max Injected Memories",
      "help": "Default 8: retrieval stays bounded even when capture is aggressive."
    },
    "routing.maxInjectedChars": {
      "label": "Max Injected Characters",
      "help": "Default 2500: memory context remains sparse and relevance-gated."
    },
    "memory": {
      "label": "Aggressive Memory Policy",
      "help": "Separates retrieval from authority, and authority from capture; stores only distilled, scoped, safe memories; recall values disclose only on explicit request."
    },
    "memory.sensitiveRecall": {
      "label": "Sensitive Recall Rules",
      "help": "Allows user-authorized benign recall rules while blocking credential plaintext and proactive disclosure."
    },
    "graphMaintenance": {
      "label": "Memory Graph Maintenance",
      "help": "Runs passively in the background. Creates dry-run/proposal records and only auto-applies deterministic low-risk cleanup unless you turn that off."
    },
    "graphMaintenance.safeAutoApply": {
      "label": "Safe Auto Apply",
      "help": "When enabled, only exact duplicate consolidation, bad-edge retirement, and observation-only feedback rows can apply automatically. Authority, privacy, tombstone, scope, and semantic changes remain review-gated."
    },
    "codexBridge": {
      "label": "Codex Continuity Bridge",
      "help": "OpenClawBrain-owned read-only Codex status, watches, and handoff briefs. Telegram-to-Codex writes stay disabled by default."
    },
    "codexBridge.enableTelegramWrites": {
      "label": "Enable Telegram Codex Writes",
      "help": "Off by default for public installs. When enabled with trusted senders and repo allowlists, Telegram can send exact messages into bound Codex threads."
    },
    "codexBridge.enableTelegramSteer": {
      "label": "Enable Telegram Codex Steering",
      "help": "Off by default for public installs. Jonathan local profiles can enable it so /brain codex steer sends a bounded turn/steer message to an active Codex turn."
    }
  }
}
