          "maxSafeAutoApplyPerRun": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "default": 5
          }
        },
        "default": {
          "enabled": true,
          "mode": "passive",
          "intervalMs": 900000,
          "runOnStartup": true,
          "startupDelayMs": 30000,
          "maxNodesPerRun": 1000,
          "safeAutoApply": true,
          "maxSafeAutoApplyPerRun": 5
        }
      },
      "privacy": {
        "type": "object",
