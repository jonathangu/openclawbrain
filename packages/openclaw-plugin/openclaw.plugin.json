{
  "id": "openclawbrain",
  "name": "OpenClawBrain",
  "version": "0.2.31",
  "description": "Aggressive-but-safe local memory graph for OpenClaw: learned routing, Memory Authority resolution, audited capture, tombstone-aware forgetting, bounded memory context, and SQLite proof surfaces.",
  "kind": "memory",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "mode": {
        "type": "string",
        "enum": [
          "off",
          "proof-only",
          "conservative",
          "active",
          "balanced",
          "aggressive"
        ],
        "default": "balanced"
      },
      "activationRoot": {
        "type": "string",
        "default": "~/.openclawbrain/activation/${agentId}"
      },
      "proofEvents": {
        "type": "boolean",
        "default": true
      },
      "proofRetentionEvents": {
        "type": "integer",
        "minimum": 50,
        "maximum": 50000,
        "default": 1000
      },
      "maxContextChars": {
        "type": "integer",
        "minimum": 500,
        "maximum": 20000,
        "default": 3000
      },
      "includeActivationContext": {
        "type": "boolean",
        "default": true
      },
      "rawTranscriptUpload": {
        "type": "boolean",
        "const": false,
        "default": false
      },
      "hooks": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowPromptContext": {
            "type": "boolean",
            "default": true
          },
          "allowConversationAccess": {
            "type": "boolean",
            "default": true
          },
          "allowToolObservation": {
            "type": "boolean",
            "default": true
          }
        },
        "default": {
          "allowPromptContext": true,
          "allowConversationAccess": true,
          "allowToolObservation": true
        }
      },
      "scopes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "main"
            ]
          }
        },
        "default": {
          "agents": [
            "main"
          ]
        }
      },
      "llm": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "routeModel": {
            "type": "string",
            "default": "qwen2.5:32b-instruct"
          },
          "plannerModel": {
            "type": "string",
            "default": "qwen2.5:32b-instruct"
          },
          "feedbackModel": {
            "type": "string",
            "default": "qwen2.5:32b-instruct"
          },
          "learningModel": {
            "type": "string",
            "default": "qwen2.5:32b-instruct"
          },
          "baseUrl": {
            "type": "string",
            "default": "http://localhost:11434/v1"
          },
          "allowedModels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "qwen2.5:32b-instruct",
              "qwen3.5:9b",
              "qwen3.5:35b-a3b",
              "gemma4:31b"
            ]
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "default": 0
          },
          "maxTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "default": 1200
          },
          "allowRemoteLlm": {
            "type": "boolean",
            "default": false,
            "description": "Allow non-loopback OpenAI-compatible LLM endpoints. Defaults false for privacy."
          }
        },
        "default": {
          "enabled": true,
          "routeModel": "qwen2.5:32b-instruct",
          "plannerModel": "qwen2.5:32b-instruct",
          "feedbackModel": "qwen2.5:32b-instruct",
          "learningModel": "qwen2.5:32b-instruct",
          "baseUrl": "http://localhost:11434/v1",
          "allowedModels": [
            "qwen2.5:32b-instruct",
            "qwen3.5:9b",
            "qwen3.5:35b-a3b",
            "gemma4:31b"
          ],
          "temperature": 0,
          "maxTokens": 1200,
          "allowRemoteLlm": false
        }
      },
      "latency": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "noSynchronousLlmByDefault": {
            "type": "boolean",
            "default": true
          },
          "syncPlannerEnabled": {
            "type": "boolean",
            "default": true
          },
          "syncPlannerSoftTimeoutMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 10000,
            "default": 900
          },
          "syncPlannerHardTimeoutMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 30000,
            "default": 1800
          },
          "maxSyncPlannerCallsPerSession": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "default": 5
          },
          "maxSyncPlannerCallsPerHour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 30
          },
          "fallbackOnTimeout": {
            "type": "string",
            "enum": [
              "no_memory",
              "cached_route",
              "high_confidence_corrections_only"
            ],
            "default": "cached_route"
          }
        }
      },
      "capture": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "mode": {
            "type": "string",
            "enum": [
              "off",
              "async_only",
              "hybrid",
              "sync_for_high_signal",
              "aggressive"
            ],
            "default": "aggressive"
          },
          "minConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.7
          },
          "feedbackTimeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 300000,
            "default": 60000
          },
          "immediateCorrectionCapture": {
            "type": "boolean",
            "default": true
          },
          "postRunWorkflowCapture": {
            "type": "boolean",
            "default": true
          },
          "storeCandidates": {
            "type": "boolean",
            "default": true
          },
          "agentEndMode": {
            "type": "string",
            "enum": [
              "enqueue",
              "best_effort_async"
            ],
            "default": "enqueue"
          }
        },
        "default": {
          "enabled": true,
          "mode": "aggressive",
          "immediateCorrectionCapture": true,
          "postRunWorkflowCapture": true,
          "storeCandidates": true,
          "agentEndMode": "enqueue"
        }
      },
      "routing": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "mode": {
            "type": "string",
            "enum": [
              "off",
              "cached_policy_only",
              "hybrid_llm_on_cache_miss",
              "aggressive_llm"
