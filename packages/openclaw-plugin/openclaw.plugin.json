            "default": "hybrid_llm_on_cache_miss"
          },
          "minRouteConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.7
          },
          "maxCandidateMemories": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 40
          },
          "maxInjectedMemories": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "default": 8
          },
          "maxInjectedChars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20000,
            "default": 2500
          },
          "learnFromOutcomes": {
            "type": "boolean",
            "default": true
          }
        },
        "default": {
          "enabled": true,
          "mode": "hybrid_llm_on_cache_miss",
          "minRouteConfidence": 0.7,
          "maxCandidateMemories": 40,
          "maxInjectedMemories": 8,
          "maxInjectedChars": 2500,
          "learnFromOutcomes": true
        }
      },
      "learning": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "intervalMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 86400000,
            "default": 60000
          },
          "minExamplesForPolicyUpdate": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 5
          },
          "maxPositiveExamples": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 25
          },
          "maxNegativeExamples": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 25
          },
          "pruneIntervalMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 86400000,
            "default": 3600000
          },
          "maxMemoryNodesPerAgent": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "default": 5000
          }
        }
      },
      "graphMaintenance": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "mode": {
            "type": "string",
            "enum": [
              "off",
              "passive",
              "dry_run",
              "safe_auto"
            ],
            "default": "passive"
          },
          "intervalMs": {
            "type": "integer",
            "minimum": 60000,
            "maximum": 86400000,
            "default": 900000
          },
          "runOnStartup": {
            "type": "boolean",
            "default": true
          },
          "startupDelayMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000,
            "default": 30000
          },
          "maxNodesPerRun": {
            "type": "integer",
            "minimum": 50,
            "maximum": 100000,
            "default": 1000
