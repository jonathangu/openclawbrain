{
  "manifest_version": "ocb.traces.manifest.v1",
  "program": "OpenClawBrain V5 evidence scoreboard",
  "mode": "smoke",
  "evidence_label": "NOT PRODUCT EVIDENCE / SYNTHETIC PIPELINE VALIDATION ONLY",
  "production_requirements": {
    "min_admitted_real_traces": 40,
    "required_slice_minimums": {
      "direct-answer": 6,
      "continuation": 6,
      "correction-follow-up": 8,
      "retrieval-heavy": 6,
      "tool-heavy": 6,
      "stale-memory-conflict": 8
    }
  },
  "traces": [
    {
      "id": "trace-001-direct-answer",
      "title": "Direct answer should not receive unnecessary memory context",
      "path": "eval/traces/smoke/trace-001-direct-answer",
      "input_file": "input.json",
      "provenance_file": "provenance.json",
      "mode": "smoke",
      "admitted": false,
      "provenance_type": "synthetic",
      "counts_as_product_evidence": false,
      "privacy_scrubbed": true,
      "slice": "direct-answer",
      "priority_class": "secondary"
    },
    {
      "id": "trace-002-continuation",
      "title": "Continuation should use immediately relevant project state",
      "path": "eval/traces/smoke/trace-002-continuation",
      "input_file": "input.json",
      "provenance_file": "provenance.json",
      "mode": "smoke",
      "admitted": false,
      "provenance_type": "synthetic",
      "counts_as_product_evidence": false,
      "privacy_scrubbed": true,
      "slice": "continuation",
      "priority_class": "primary"
    },
    {
      "id": "trace-003-correction-follow-up",
      "title": "Correction follow-up should preserve a user correction",
      "path": "eval/traces/smoke/trace-003-correction-follow-up",
      "input_file": "input.json",
      "provenance_file": "provenance.json",
      "mode": "smoke",
      "admitted": false,
      "provenance_type": "synthetic",
      "counts_as_product_evidence": false,
      "privacy_scrubbed": true,
      "slice": "correction-follow-up",
      "priority_class": "primary"
    },
    {
      "id": "trace-004-retrieval-heavy",
      "title": "Retrieval-heavy question benefits from selective memory retrieval",
      "path": "eval/traces/smoke/trace-004-retrieval-heavy",
      "input_file": "input.json",
      "provenance_file": "provenance.json",
      "mode": "smoke",
      "admitted": false,
      "provenance_type": "synthetic",
      "counts_as_product_evidence": false,
      "privacy_scrubbed": true,
      "slice": "retrieval-heavy",
      "priority_class": "secondary"
    },
    {
      "id": "trace-005-tool-heavy",
      "title": "Tool-heavy task should choose the right workflow with read-only fixtures",
      "path": "eval/traces/smoke/trace-005-tool-heavy",
      "input_file": "input.json",
      "provenance_file": "provenance.json",
      "mode": "smoke",
      "admitted": false,
      "provenance_type": "synthetic",
      "counts_as_product_evidence": false,
      "privacy_scrubbed": true,
      "slice": "tool-heavy",
      "priority_class": "secondary"
    },
    {
      "id": "trace-006-stale-memory-conflict",
      "title": "Stale-memory conflict should prefer current task truth",
      "path": "eval/traces/smoke/trace-006-stale-memory-conflict",
      "input_file": "input.json",
      "provenance_file": "provenance.json",
      "mode": "smoke",
      "admitted": false,
      "provenance_type": "synthetic",
      "counts_as_product_evidence": false,
      "privacy_scrubbed": true,
      "slice": "stale-memory-conflict",
      "priority_class": "primary"
    }
  ]
}
