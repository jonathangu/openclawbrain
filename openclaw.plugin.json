{
  "id": "openclawbrain",
  "name": "OpenClawBrain",
  "version": "0.1.0",
  "description": "Local, agent-scoped selective intervention layer with redacted proof events.",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "mode": { "type": "string", "enum": ["off", "proof-only", "conservative", "active"], "default": "conservative" },
      "activationRoot": { "type": "string", "default": "~/.openclawbrain/activation/${agentId}" },
      "proofEvents": { "type": "boolean", "default": true },
      "proofRetentionEvents": { "type": "integer", "minimum": 50, "maximum": 50000, "default": 1000 },
      "maxContextChars": { "type": "integer", "minimum": 500, "maximum": 20000, "default": 3000 },
      "includeActivationContext": { "type": "boolean", "default": true },
      "rawTranscriptUpload": { "type": "boolean", "const": false, "default": false },
      "scopes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agents": { "type": "array", "items": { "type": "string" }, "default": ["main"] }
        },
        "default": { "agents": ["main"] }
      }
    }
  }
}
