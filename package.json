{
  "name": "openclawbrain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "description": "OpenClawBrain V5 evidence scoreboard pipeline workspace.",
  "scripts": {
    "ocb:results:schema-test": "node --test packages/results-schema/test/*.test.ts",
    "ocb:ledger:validate": "node packages/results-schema/src/ledger.ts",
    "ocb:traces:validate": "node scripts/traces/validate.mjs --mode smoke",
    "ocb:traces:validate:smoke": "node scripts/traces/validate.mjs --mode smoke",
    "ocb:traces:validate:production": "node scripts/traces/validate.mjs --mode production",
    "ocb:eval:run": "node packages/eval-harness/src/run.ts",
    "ocb:eval:make-blind-packets": "node packages/eval-harness/src/blind-packets.ts",
    "ocb:eval:smoke": "pnpm ocb:eval:run -- --mode smoke --run-id smoke-pr4",
    "ocb:judgments:import": "node packages/eval-harness/src/judging/import-judgments.ts",
    "ocb:results:generate": "node packages/results-site/src/generate.ts",
    "ocb:decision:generate": "node packages/results-site/src/generate.ts --decision-only"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
