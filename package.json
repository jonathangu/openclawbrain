{
  "name": "@jonathangu/openclawbrain",
  "version": "0.4.47",
  "description": "OpenClawBrain monorepo workspace for the canonical 0.4.47 split-package lane.",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "license": "MIT",
  "author": "Jonathan Gu",
  "keywords": [
    "openclawbrain",
    "openclaw",
    "openclaw-plugin",
    "compatibility",
    "context-management",
    "llm",
    "summarization",
    "conversation-memory",
    "dag"
  ],
  "files": [
    "bin/",
    "index.ts",
    "src/**/*.ts",
    "openclaw.plugin.json",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "changeset": "changeset",
    "release:plan": "node scripts/release-plan.mjs",
    "release:prepare:openclaw": "npm --prefix packages/openclaw install --package-lock=false --no-save --ignore-scripts --fund=false --audit=false",
    "release:prepare:cli": "npm --prefix packages/cli install --package-lock=false --no-save --ignore-scripts --fund=false --audit=false",
    "release:prepare:packages": "npm run release:prepare:openclaw && npm run release:prepare:cli",
    "release:verify": "npm run release:verify:dependency-policy && npm test && npm run release:verify:proof && npm pack --dry-run && npm run release:verify:openclaw && npm run release:verify:cli",
    "release:verify:dependency-policy": "node scripts/verify-dependency-policy.mjs",
    "release:verify:proof": "node scripts/verify-proof-smoke.mjs",
    "release:verify:docs-drift": "node scripts/verify-release-docs-drift.mjs",
    "release:verify:cli": "npm run release:prepare:cli && npm --prefix packages/cli run release:verify",
    "release:verify:openclaw": "npm run release:prepare:openclaw && npm --prefix packages/openclaw run release:verify",
    "graphify:delta-cadence": "node scripts/graphify-delta-cadence.mjs",
    "graphify:reorg-cadence": "node scripts/graphify-reorg-cadence.mjs",
    "graphify:scheduler": "node scripts/graphify-scheduler.mjs",
    "proof:continuous-learning": "node --experimental-transform-types scripts/continuous-learning-acceptance.ts",
    "proof:health": "node scripts/proof-cron.mjs health",
    "proof:nightly": "node scripts/proof-cron.mjs nightly",
    "proof:hard-memory-scorecard": "node scripts/hard-memory-scorecard.mjs",
    "proof:frozen-eval-gate": "node --experimental-transform-types scripts/run-frozen-recorded-session-eval-gate.ts",
    "proof:replay-lane": "node --experimental-transform-types scripts/build-recorded-session-replay-lane.ts",
    "eval:comparative": "node --experimental-transform-types scripts/eval/run-comparative-eval.ts",
    "test": "vitest run --dir test",
    "test:learned-route-mission": "vitest run --dir test test/brain-core/graphify-training-bridge.test.ts test/brain-core/policy-supervision-rows.test.ts test/brain-core/route-decision-event.test.ts test/brain-core/route-outcome-events.test.ts test/brain-core/cold-start-router-trainer.test.ts test/brain-core/cold-start-router-runtime.test.ts test/brain-core/cold-start-router-replay-gate.test.ts test/brain-core/cold-start-router-periodic-retrain.test.ts",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@openclawbrain/compiler": "file:packages/compiler",
    "@openclawbrain/contracts": "file:packages/contracts",
    "@openclawbrain/event-export": "file:packages/event-export",
    "@openclawbrain/events": "file:packages/events",
    "@openclawbrain/learner": "file:packages/learner",
    "@openclawbrain/pack-format": "file:packages/pack-format",
    "@openclawbrain/provenance": "file:packages/provenance",
    "@openclawbrain/workspace-metadata": "file:packages/workspace-metadata",
    "@mariozechner/pi-agent-core": "0.53.0",
    "@mariozechner/pi-ai": "0.53.0",
    "@sinclair/typebox": "0.34.48",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^24.12.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "basic-ftp": "5.2.0",
    "hono": "4.12.7",
    "@hono/node-server": "1.19.10",
    "undici": "7.24.0",
    "yaml": "2.8.3",
    "fast-xml-parser": "5.5.10",
    "minimatch": "10.2.3",
    "brace-expansion": "5.0.5"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "openclawbrain": "./bin/openclawbrain.js"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathangu/openclawbrain.git"
  },
  "homepage": "https://github.com/jonathangu/openclawbrain#readme",
  "bugs": {
    "url": "https://github.com/jonathangu/openclawbrain/issues"
  }
}
