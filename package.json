{
  "name": "openclawbrain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "description": "OpenClawBrain V5 evidence scoreboard pipeline workspace.",
  "scripts": {
    "ocb:results:schema-test": "node --test packages/results-schema/test/*.test.ts",
    "ocb:ledger:validate": "node packages/results-schema/src/ledger.ts",
    "ocb:traces:validate": "node scripts/traces/validate.mjs --mode smoke",
    "ocb:traces:validate:smoke": "node scripts/traces/validate.mjs --mode smoke",
    "ocb:traces:validate:production": "node scripts/traces/validate.mjs --mode production --manifest eval/traces/production.manifest.json",
    "ocb:eval:run": "node packages/eval-harness/src/run.ts",
    "ocb:eval:make-blind-packets": "node packages/eval-harness/src/blind-packets.ts",
    "ocb:eval:smoke": "pnpm ocb:eval:run -- --mode smoke --run-id smoke-pr4",
    "ocb:judgments:import": "node packages/eval-harness/src/judging/import-judgments.ts",
    "ocb:results:generate": "node packages/results-site/src/generate.ts",
    "ocb:decision:generate": "node packages/results-site/src/generate.ts --decision-only",
    "ocb:e2e:smoke": "node scripts/ocb-e2e-smoke.mjs",
    "ocb:traces:admit": "node scripts/traces/admit.mjs",
    "ocb:traces:admit:test": "node --test scripts/traces/admit.test.mjs",
    "ocb:runtime:export-candidate": "node scripts/runtime/export-candidate.mjs",
    "ocb:runtime:export-candidate:test": "node --test scripts/runtime/export-candidate.test.mjs",
    "ocb:traces:production-status": "node scripts/traces/status.mjs",
    "ocb:traces:production-status:test": "node --test scripts/traces/status.test.mjs",
    "ocb:runtime:capture-event": "node scripts/runtime/capture-event.mjs",
    "ocb:runtime:capture-event:test": "node --test scripts/runtime/capture-event.test.mjs",
    "ocb:runtime:decide": "node scripts/runtime/decide.mjs",
    "ocb:runtime:decide:test": "node --test scripts/runtime/decide.test.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
